# iScholar v6.0 — all-in-Docker platform environment template.
# Copy to `.env` and replace placeholder values. `.env` is git-ignored.
# Every value here is server-side only unless prefixed with NEXT_PUBLIC_.

# ── Postgres ────────────────────────────────────────────────────────────────
# Used by the backend (asyncpg driver) and Alembic.
DATABASE_URL=postgresql+asyncpg://ischolar:ischolar@postgres:5432/ischolar
# Plain libpq URL used by the web container / Auth.js adapter (auth tables only).
AUTH_DATABASE_URL=postgresql://ischolar:ischolar@postgres:5432/ischolar
POSTGRES_USER=ischolar
POSTGRES_PASSWORD=ischolar
POSTGRES_DB=ischolar
POSTGRES_PORT=5432

# ── Redis (rate limits, pub/sub) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Blob storage (attachments / scripts) ───────────────────────────────────
# Filesystem volume mounted into backend + worker by compose.
STORAGE_DIR=/data/storage

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Required in the compose stack (no fallback); production rejects the placeholder.
AUTH_SECRET=dev-insecure-change-me
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── SMTP (training invites) ─────────────────────────────────────────────────
# When unset, invites create the user but skip email delivery (the API still
# returns ok). Configure to actually send accept links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Backend environment ─────────────────────────────────────────────────────
# Compose defaults this to `production` (startup secret guards reject the
# placeholder AGENT_SERVICE_TOKEN). `docker-compose.dev.yml` forces
# `development`. Leave it unset here so the secure default applies.
# ENVIRONMENT=production

# ── Local-only API bypass (dev / tests) ─────────────────────────────────────
# When true, legacy API routes without an Auth.js session use the "local" identity.
# NEVER enable in production; the Vitest setup sets it for unit tests.
ALLOW_LOCAL_API=false

# ── Backend ↔ web service identity ─────────────────────────────────────────
# Shared secret used to sign the identity forwarded from web to backend.
AGENT_SERVICE_TOKEN=dev-insecure-change-me
BACKEND_INTERNAL_URL=http://backend:8000
BACKEND_PORT=8000

# ── DeepSeek (server-side only) ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Agent runtime: langgraph (per-agent graphs) | legacy (old web proxy)
AGENT_RUNTIME=langgraph
# Require a recorded ai_consents_v2 row (with external services) before a run.
AGENT_REQUIRE_CONSENT=true
# Force the deterministic fake model (tests/CI)
AGENT_MODEL_FAKE=false
# Evaluation harness (Stage 5)
EVAL_MODE=offline
EVAL_THRESHOLD=0.8

# ── MCP (Stage 3) ───────────────────────────────────────────────────────────
# Built-in tools run in-process. MCP_SERVERS is a JSON list of external
# streamable-HTTP endpoints for the client pool, e.g.
#   [{"name":"ischolar","url":"http://backend:8000/mcp"}]
MCP_ENABLED=true
MCP_SERVERS=[]
# Bearer token required by the standalone MCP server endpoint (optional in dev).
# MCP_SERVER_TOKEN=
MCP_REQUEST_MAX_BYTES=2097152
MCP_RESPONSE_MAX_BYTES=2097152

# ── Optional tracing ────────────────────────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ischolar

# ── Web / proxy ports ───────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Caddy site address: a real hostname enables automatic ACME TLS; `localhost`
# uses Caddy's internal CA.
DOMAIN=localhost
# Behind a reverse proxy, set true so Auth.js trusts X-Forwarded-Host.
AUTH_TRUST_HOST=false

# ── Research data backend (migration switch) ────────────────────────────────
# `legacy` (default) keeps the browser-local Dexie/Supabase hooks in
# lib/local/hooks/*. `backend` routes research-core hooks through the signed BFF
# (/api/data/*) using React Query. Inlined at build time — rebuild after changing.
NEXT_PUBLIC_DATA_BACKEND=legacy

# ── Legacy Supabase collaborative mode (migration only) ─────────────────────
# Enables the old Supabase data layer (lib/supabase/*, training camp, remote
# sync). Off by default; the target platform does not use it. Set to true only
# while the legacy stack is still in use. Requires the NEXT_PUBLIC_SUPABASE_* vars.
# NEXT_PUBLIC_COLLABORATIVE_MODE=true
